    "### FUNCTION to write a DataFrame in DB PARQUET in some path"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "85efee56",
   "metadata": {},
   "outputs": [],
   "source": [
    "def write_db(df,caminho):\n",
    "    df.to_parquet(\n",
    "        caminho,\n",
    "        engine=\"pyarrow\",\n",
    "        index=False\n",
    "    )\n",
    "\n",
    "    return print(\"db_bronze.parquet gerado com sucesso!\")"
   ]
  }
